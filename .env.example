# =====================================================================
# Swadeep Shikshan Vikas Sanstha — Environment Configuration
# Copy this file to .env.local for local development.
# DO NOT commit real production passwords or keys.
# =====================================================================

# Server Ports
PORT=3000
BACKEND_PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
# You can provide either a full DATABASE_URL or individual parameters below:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swadeep_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=swadeep_db
PGUSER=postgres
PGPASSWORD=your_local_postgres_password
DB_POOL_MAX=10

# Security & Authentication
JWT_SECRET=your-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=24h

# Default Seed Admin Credentials (used during initial db:seed or local fallback)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Swadeep@Admin2026!

# Rate Limiting (Protection against spam and abuse)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60000

# Contact Form Email Notifications (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# CONTACT_EMAIL=swadeepindiango@gmail.com
